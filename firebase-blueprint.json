{
  "entities": {
    "Resume": {
      "title": "Resume Document",
      "description": "User resume data containing personal information, experience, education, skills, projects, and styling preferences.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "personalInfo": { "type": "object" },
        "summary": { "type": "string", "maxLength": 4000 },
        "experience": { "type": "array" },
        "education": { "type": "array" },
        "skills": { "type": "array" },
        "projects": { "type": "array" },
        "certifications": { "type": "array" },
        "languages": { "type": "array" },
        "templateId": { "type": "string", "maxLength": 50 },
        "themeColor": { "type": "string", "maxLength": 20 },
        "fontFamily": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "personalInfo"]
    }
  },
  "firestore": {
    "/resumes/{resumeId}": {
      "schema": "Resume",
      "description": "Collection of user resumes"
    }
  }
}
